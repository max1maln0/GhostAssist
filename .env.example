# Укажите ключ в Dashboard или здесь.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ACTIVE_PROFILE=example_legend.md

# Максимальный размер полноэкранного снимка.
CROP_WIDTH=1280
CROP_HEIGHT=720

# Дедлайны в секундах и предел PCM-буфера в МиБ.
REQUEST_TIMEOUT=12
TASK_TIMEOUT=30
AUDIO_MAX_SECONDS=60
AUDIO_MAX_MIB=12
MEMORY_ENABLED=true
MEMORY_DEPTH=6

HOTKEY_SCREEN=<alt>+q
HOTKEY_SNIP=<alt>+s
HOTKEY_AUDIO=<alt>+r
HOTKEY_MODE=<alt>+m
HOTKEY_HUD=<alt>+x
HOTKEY_DOCK=<alt>+<down>
HOTKEY_CANCEL=<ctrl>+<shift>+<f12>
HOTKEY_PAGE_UP=<alt>+<page_up>
HOTKEY_PAGE_DOWN=<alt>+<page_down>
