# Ключ от Google AI Studio (обязателен):
GEMINI_API_KEY=AIzaSy_ТВОЙ_КЛЮЧ_ЗДЕСЬ
# Рабочая модель для минимальной задержки:
GEMINI_MODEL=gemini-2.5-flash

# Файл из папки config/profiles/, используемый в режиме INTERVIEW:
ACTIVE_PROFILE=my_legend.md

# Разрешение для полноэкранного сжатия (1280x720 / 1920x1080):
CROP_WIDTH=1280
CROP_HEIGHT=720

# Снимок всего экрана и решение:
HOTKEY_SCREEN=<alt>+q 
# Снайперское выделение прямоугольной области:
HOTKEY_SNIP=<alt>+s
# Запись системного звука (ручной старт/стоп):
HOTKEY_AUDIO=<alt>+r
# Смена режима подсказок (TEST <-> INTERVIEW):
HOTKEY_MODE=<alt>+m
# Быстрое скрытие / показ плашки подсказок:
HOTKEY_HUD=t