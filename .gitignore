# Секреты и переменные окружения
.env
*.env
!.env.example
# Временные копии dotenv могут остаться после аварийного завершения.
.ghostassist-env-*.tmp

# Личные профили и легенды (резюме, личные данные)
config/profiles/*
!config/profiles/example_legend.md
config/user_settings.json

# Python кэш и окружение
__pycache__/
*.py[cod]
venv/
.venv/
env/

# Логи и временные дампы
*.log
*.wav
*.jpg
*.png
# Static analysis cache
.ruff_cache/
